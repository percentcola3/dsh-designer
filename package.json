{
  "name": "@local/dsh-designer",
  "version": "0.4.20",
  "description": "AI design workbench with editable and interactive HTML, versioned projects and resources, source comparison, runtime integration and delivery.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "model-output.js",
    "diagnostics-service.js",
    "diagnostics-guides.js",
    "store.js",
    "client.js",
    "import-service.js",
    "browser-engine.js",
    "design-import.js",
    "asset-archive.js",
    "document-model.js",
    "workspace-service.js",
    "editor-service.js",
    "framework-service.js",
    "framework-compiler.js",
    "framework-operations.js",
    "source-workflows.js",
    "delivery-service.js",
    "portable-project.js",
    "project-package-service.js",
    "project-sync-service.js",
    "builtin-git-engine.js",
    "builtin-git-helper.js",
    "git-ssh-transport.js",
    "ssh-profile-service.js",
    "ai-workbench.js",
    "ai-adapter.js",
    "ai-target-policy.js",
    "project-policy.js",
    "knowledge-reference.js",
    "knowledge-service.js",
    "knowledge-import-service.js",
    "knowledge-import-helper.js",
    "knowledge-lexical-engine.js",
    "zg-service.js",
    "zg-helper.js",
    "zg-runtime.js",
    "vendor/*.js",
    "vendor/zg-provenance.json",
    "build-zg-runtime.mjs",
    "capture-service.js",
    "resource-service.js",
    "upload-service.js",
    "composer-service.js",
    "client-session.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "licenses/*.txt",
    "README.md",
    "DEBUGGING.md",
    "DIAGNOSTICS.md",
    "CONTINUATION.md",
    "SOURCE-REMAINING.md",
    "SOURCE-MODE.md",
    "REQUIREMENTS.md",
    "WORKBENCH-PLAN.md",
    "ui/API-CONTRACT.md",
    "ui/UI-NOTES.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "docs/FEATURES.md",
    "docs/RELEASING.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node scripts/test.mjs",
    "verify:package": "node verify-package.mjs",
    "dev": "sh scripts/designer-debug.sh",
    "check": "node build.mjs --check",
    "test:focused": "node scripts/test.mjs --focused",
    "test:models": "node scripts/test.mjs --models",
    "ci": "npm run build && npm test && npm run verify:package",
    "release:pack": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "@babel/generator": "^7.29.13",
    "@babel/parser": "^7.29.13",
    "@babel/traverse": "^7.29.13",
    "@huggingface/tokenizers": "0.2.0",
    "@vscode/ripgrep": "1.18.0",
    "@vue/compiler-sfc": "^3.5.45",
    "esbuild-wasm": "^0.28.2",
    "isomorphic-git": "1.44.13",
    "parse5": "^8.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2": "1.17.0",
    "tree-sitter-wasms": "0.1.13",
    "vue": "^3.5.45",
    "web-tree-sitter": "0.27.2"
  },
  "optionalDependencies": {
    "@zvec/bindings-darwin-arm64": "0.8.0",
    "@zvec/bindings-linux-arm64": "0.8.0",
    "@zvec/bindings-linux-arm64-musl": "0.8.0",
    "@zvec/bindings-linux-x64": "0.8.0",
    "@zvec/bindings-linux-x64-musl": "0.8.0",
    "@zvec/bindings-win32-x64": "0.8.0"
  },
  "devDependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/merge": "^6.12.3",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "marked": "^18.2.0",
    "pdfjs-dist": "4.8.69"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/percentcola3/dsh-designer.git"
  },
  "homepage": "https://github.com/percentcola3/dsh-designer#readme",
  "bugs": {
    "url": "https://github.com/percentcola3/dsh-designer/issues"
  }
}
